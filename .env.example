# ==============================================================================
# GKSKLaiXe — Mẫu cấu hình môi trường (.env.example)
# Sao chép thành `.env` ở thư mục gốc và điền giá trị thực tế.
# TUYỆT ĐỐI KHÔNG commit file `.env` lên git.
# ==============================================================================

# Môi trường chạy: test | production
# Khi APP_ENV=production: bắt buộc GKSK_BASE_URL dùng https://, giao diện hiện banner đỏ
APP_ENV=test
PORT=3001
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Kết nối MSSQL trên server hiện tại (toàn bộ bảng dùng tiền tố gksk_)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=GKSKLaiXe
# true nếu dùng Azure SQL hoặc bắt buộc TLS
DB_ENCRYPT=false
# true cho SQL Server nội bộ dùng self-signed certificate
DB_TRUST_SERVER_CERT=true

# ------------------------------------------------------------------------------
# Cấu hình kết nối API Sở Y tế Đồng Nai (tài khoản CSYT)
# ------------------------------------------------------------------------------
# Không có dấu / ở cuối (app tự chuẩn hóa cắt bỏ nếu lỡ có)
GKSK_BASE_URL=https://api-example.dongnai.gov.vn
# Mã CSYT 5 chữ số
GKSK_USERNAME=75001
GKSK_PASSWORD=CHANGE_ME_CSYT_PASSWORD
# = IDBENHVIEN trong XML, thường trùng GKSK_USERNAME
GKSK_FACILITY_ID=75001
# Điền vào thẻ BENHVIEN trong XML
GKSK_FACILITY_NAME=Trung tam Y te Mau Dong Nai
# Mặc định bằng GKSK_FACILITY_ID nếu để trống
GKSK_SENDER_ID=
# Tùy chọn: đường dẫn tới file khóa riêng .pem để ký RSA gói tin
GKSK_PRIVATE_KEY_PATH=
GKSK_HTTP_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Đăng nhập nội bộ ứng dụng web (kết hợp bảng dbo.gksk_users + dự phòng .env)
# ------------------------------------------------------------------------------
APP_LOGIN_USER=admin
# Cách 1 (Khuyến nghị): Chuỗi hash bcrypt của mật khẩu đăng nhập app
APP_LOGIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_BCRYPT_HASH_OF_APP_PASSWORD
# Cách 2 (Tùy chọn tiện lợi): Nhập mật khẩu thường để server tự băm bcrypt lúc khởi động và tự seed vào dbo.gksk_users
APP_LOGIN_PASSWORD=
# Chuỗi bí mật ngẫu nhiên dài (>= 32 ký tự) để ký cookie phiên
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARS
# Tùy chọn: đặt true khi chạy mạng LAN nội bộ qua HTTP thuần (không có HTTPS) ở chế độ APP_ENV=production
# để trình duyệt chấp nhận gửi cookie phiên qua HTTP (mặc định false = bắt buộc cookie Secure khi production)
ALLOW_INSECURE_COOKIE=false

# ------------------------------------------------------------------------------
# Tùy chọn Subpath khi chạy dưới thư mục con của IIS (vd: http://192.168.1.140/KSKLaiXe)
# Mặc định để trống (chạy ở đường dẫn gốc "/"). Nếu dùng subpath, đặt "/KSKLaiXe" trước khi chạy `npm run build`
# ------------------------------------------------------------------------------
VITE_BASE_PATH=
